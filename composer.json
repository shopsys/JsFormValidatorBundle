{
    "name": "shopsys/jsformvalidator-bundle",
    "type": "symfony-bundle",
    "description": "Javascript validation for Symfony forms.",
    "keywords": ["Symfony", "Form", "Javascript", "Validation"],
    "homepage": "https://github.com/shopsys/JsFormValidatorBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Ton Sharp",
            "email": "66ton99@gmail.com"
        },
        {
            "name": "Yury Maltsev",
            "email": "dev.yury.maltsev@gmail.com"
        }
    ],

    "require": {
        "php": "^8.3",
        "symfony/form": "^6.4 | ^7.1",
        "symfony/validator": "^6.4 | ^7.1"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "ext-pdo_sqlite": "*",
        "erusev/parsedown": "^1.6",
        "symfony/asset": "*",
        "symfony/console": "*",
        "symfony/dotenv": "*",
        "symfony/expression-language": "*",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "*",
        "symfony/intl": "*",
        "symfony/translation": "*",
        "symfony/twig-bundle": "*",
        "symfony/webpack-encore-bundle": "*",
        "symfony/yaml": "*",
        "symfony/html-sanitizer": "*",
        "symfony/security-csrf": "*",
        "twig/twig": "^2.6"
    },

    "suggest": {
        "symfony/symfony": "For using as a Symfony Bundle and for using a default ajax validation"
    },

    "autoload": {
        "psr-4": {
            "Fp\\JsFormValidatorBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "Tests/app/src"
        }
    },

    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "^6.4 | ^7.1"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
